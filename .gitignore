# 模板是 config.example.yaml，那个可以提交。
config/config.yaml

# 运行时状态：事件表、成本台账、日志、中间产物
state/

# Docker 的密钥文件
docker/**/.env

# ── 环境 ────────────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# ── 编辑器 / 系统 ───────────────────────────────────────────────────
.obsidian/workspace*.json
.vscode/settings.json
Thumbs.db
desktop.ini

# ── Obsidian 库：个人数据，永不入库 ──────────────────────────────────
# 里面有定位坐标、日记、作息、待办。这是一个**纯代码仓库**。
#
# 为什么连私有仓库也不进：GitHub 是第三方，而且历史不可逆 ——
# 即使之后删除，git 历史和各类镜像/爬虫里仍然留有副本。
#
# vault 的同步自己解决，二选一：
#   · Syncthing —— 设备间直接同步，不经过任何第三方
#   · git remote 指向你自己的服务器上的 bare 仓库
#
# ⚠️ 注意 `vault/` 这一行必须**顶格、不缩进、不在注释里**，
#    否则 git 不会当成规则。（曾经这里只写了注释，导致 22 个
#    含定位坐标的文件差点被推到公开仓库。）
vault/

# ── 说明 ────────────────────────────────────────────────────────────
# ⚠️ API key 不放这里，放用户级环境变量：
#      setx DEEPSEEK_API_KEY "sk-..."
#    这样它既不进文件、也不进 Obsidian 库、也不会被误同步。

# GeoNames 城市表：25MB，重新下载即可，不值得进仓库
data/

# 参考用的第三方仓库（自带 .git，提交进去会变成 gitlink 而不是文件）
FxLifeSheet/

# Claude Code 自己的目录，里面有 worktree，提交进去是一团乱麻
.claude/

# agent-canvas：给 AI 画 Excalidraw 图的 skill，用 `npx skills add` 装在项目里。
# 是**工具**不是这个项目的一部分，所以不进仓库。
# 想连它一起提交：删掉下面两行，然后 git add .agents skills-lock.json
.agents/
skills-lock.json

# 编译出来的无窗口守护程序（源码在 windows/live-daemon/）
LifeLoggingLive.exe
