{
  "uid": "lifelogging-time",
  "title": "生命记录 · 时间与分类",
  "description": "时间都去哪了：分类分布、应用/站点排行、以及逐条时间块的明细。",
  "tags": [
    "lifelogging"
  ],
  "timezone": "Asia/Shanghai",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "days",
        "label": "回看天数",
        "type": "custom",
        "query": "7,30,90,365",
        "current": {
          "text": "90",
          "value": "90"
        },
        "includeAll": false,
        "multi": false,
        "options": [],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "每日分类堆叠",
      "description": "顶部右侧的「回看天数」变量控制这里和下面几张排行的时间窗。",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "lifelogging-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "lifelogging-sqlite"
          },
          "rawQuery": true,
          "timeColumns": [
            "time"
          ],
          "rawQueryText": "SELECT strftime('%Y-%m-%dT%H:%M:%S+08:00', day_local) AS time, SUM(CASE WHEN category='Work' THEN hours ELSE 0 END) AS 'Work', SUM(CASE WHEN category='Study' THEN hours ELSE 0 END) AS 'Study', SUM(CASE WHEN category='Life' THEN hours ELSE 0 END) AS 'Life', SUM(CASE WHEN category='Transport' THEN hours ELSE 0 END) AS 'Transport', SUM(CASE WHEN category='Leisure' THEN hours ELSE 0 END) AS 'Leisure', SUM(CASE WHEN category='Health' THEN hours ELSE 0 END) AS 'Health', SUM(CASE WHEN category='Social' THEN hours ELSE 0 END) AS 'Social', SUM(CASE WHEN category='Other' THEN hours ELSE 0 END) AS 'Other' FROM blocks WHERE day_local >= date('now','+8 hours','-' || $days || ' days') GROUP BY day_local ORDER BY day_local",
          "queryType": "time series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 80,
            "barAlignment": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisPlacement": "auto",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "piechart",
      "title": "分类占比",
      "description": "同一时间窗内各分类的合计占比。",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "lifelogging-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "lifelogging-sqlite"
          },
          "rawQuery": true,
          "rawQueryText": "SELECT category AS '分类', ROUND(SUM(hours),2) AS '小时' FROM blocks WHERE day_local >= date('now','+8 hours','-' || $days || ' days') GROUP BY category ORDER BY 2 DESC",
          "queryType": "table"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "pieType": "donut",
        "displayLabels": [
          "name",
          "percent"
        ],
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value",
            "percent"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "应用排行 Top 15",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "lifelogging-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "lifelogging-sqlite"
          },
          "rawQuery": true,
          "rawQueryText": "SELECT value_text AS '应用', ROUND(SUM(value_num)/3600.0,2) AS '小时' FROM events WHERE domain='screen' AND metric='app_usage' AND day_local >= date('now','+8 hours','-' || $days || ' days') GROUP BY value_text ORDER BY 2 DESC LIMIT 15",
          "queryType": "table"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "stacking": "none",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85,
            "axisPlacement": "auto",
            "axisLabel": "",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "barchart",
      "title": "站点排行 Top 15",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "lifelogging-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "lifelogging-sqlite"
          },
          "rawQuery": true,
          "rawQueryText": "SELECT value_text AS '站点', ROUND(SUM(value_num)/60.0,1) AS '分钟' FROM events WHERE domain='web' AND metric='site_usage' AND day_local >= date('now','+8 hours','-' || $days || ' days') GROUP BY value_text ORDER BY 2 DESC LIMIT 15",
          "queryType": "table"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "stacking": "none",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85,
            "axisPlacement": "auto",
            "axisLabel": "",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "最近的时间块",
      "description": "blocks 表逐条。⚠️ normalize.py 只写时长 ≥ 6 分钟的块，所以频繁切窗口的时段可能不在这里。",
      "gridPos": {
        "h": 11,
        "w": 16,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "lifelogging-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "lifelogging-sqlite"
          },
          "rawQuery": true,
          "rawQueryText": "SELECT datetime(start_utc,'+8 hours') AS '开始(本地)', ROUND(hours,2) AS '小时', category AS '分类', app AS '应用', CASE blackhole WHEN 1 THEN '是' ELSE '' END AS '黑洞', title AS '窗口标题' FROM blocks ORDER BY start_utc DESC LIMIT 200",
          "queryType": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "窗口标题"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 420
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "小时"
            },
            "properties": [
              {
                "id": "unit",
                "value": "h"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "时间黑洞",
      "description": "blackhole = 1 的块单独列出来。全期，不受上面变量影响。",
      "gridPos": {
        "h": 11,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "lifelogging-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "lifelogging-sqlite"
          },
          "rawQuery": true,
          "rawQueryText": "SELECT datetime(start_utc,'+8 hours') AS '开始(本地)', ROUND(hours,2) AS '小时', category AS '分类', app AS '应用', title AS '窗口标题' FROM blocks WHERE blackhole = 1 ORDER BY start_utc DESC LIMIT 100",
          "queryType": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "小时"
            },
            "properties": [
              {
                "id": "unit",
                "value": "h"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      }
    }
  ]
}