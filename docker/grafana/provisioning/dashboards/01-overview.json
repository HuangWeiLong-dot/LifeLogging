              "viz": false
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "应用用时 Top 10（近 30 天）",
      "description": "events 里 domain='screen' metric='app_usage'，单位秒 → 小时。",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
