          "rawQueryText": "SELECT value_text AS '应用', ROUND(SUM(value_num)/3600.0,2) AS '小时' FROM events WHERE domain='screen' AND metric='app_usage' AND day_local >= date('now','+8 hours','-30 days') GROUP BY value_text ORDER BY 2 DESC LIMIT 10",
