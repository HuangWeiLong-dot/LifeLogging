{
  "uid": "lifelogging-overview",
  "title": "生命记录 · 概览",
  "description": "今天怎么样 + 最近 90 天的趋势。数据来自 state/events.db 的 blocks 和 events 两张表。⚠️ 「今日应用时长 / 今日浏览器」来自 collect_desktop.py 写的事件，而「今日记录时长」来自 normalize.py 直接读 ActivityWatch —— 两者是两条独立的路径，流水线还没跑完的那半天里，前者会是 0 而后者已经有数。",
  "tags": [
    "lifelogging"
  ],
  "timezone": "Asia/Shanghai",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "今日记录时长",
      "description": "blocks 表里今天（本地日期）已归类的时间块总时长。",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "lifelogging-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "lifelogging-sqlite"
          },
          "rawQuery": true,
          "rawQueryText": "SELECT ROUND(COALESCE(SUM(hours),0),2) AS h FROM blocks WHERE day_local = date('now','+8 hours')",
          "queryType": "table"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "green",
                "value": 6
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
