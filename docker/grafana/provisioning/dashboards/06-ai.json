            "uid": "lifelogging-sqlite"
          },
          "rawQuery": true,
          "timeColumns": [
            "time"
          ],
          "rawQueryText": "SELECT strftime('%Y-%m-%dT%H:%M:%S+08:00', day_local) AS time, ROUND(SUM(value_num),2) AS '实际花费' FROM events WHERE domain='ai' AND metric='spend' AND day_local >= date('now','+8 hours','-30 days') GROUP BY day_local ORDER BY day_local",
          "queryType": "time series"
        }
