    {
      "id": 10,
      "type": "table",
      "title": "每日明细",
      "description": "逐日汇总。请求数取的是当天各模型的和；缓存命中率 = 命中 /（命中+未命中）。",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "lifelogging-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "lifelogging-sqlite"
          },
          "rawQuery": true,
          "rawQueryText": "SELECT day_local AS '日期', ROUND(SUM(CASE WHEN metric='spend' THEN value_num END),2) AS '花费(元)', ROUND(SUM(CASE WHEN metric='model_tokens' THEN value_num END)/1000000.0,1)   AS 'Tokens(百万)', MAX(CASE WHEN metric='model_tokens'   THEN CAST(json_extract(meta_json,'$.requests') AS INTEGER) END) AS '请求数', ROUND(100.0 * SUM(CASE WHEN metric='model_tokens'   THEN CAST(json_extract(meta_json,'$.in_cache_hit') AS INTEGER) ELSE 0 END)   / MAX(1, SUM(CASE WHEN metric='model_tokens'   THEN CAST(json_extract(meta_json,'$.in_cache_hit') AS INTEGER)      + CAST(json_extract(meta_json,'$.in_cache_miss') AS INTEGER) ELSE 0 END)),1)   AS '缓存命中率(%)' FROM events WHERE domain='ai' AND metric IN ('spend','model_tokens') AND day_local >= date('now','+8 hours','-30 days') GROUP BY day_local ORDER BY day_local DESC",
          "queryType": "table"
        }
      ],
