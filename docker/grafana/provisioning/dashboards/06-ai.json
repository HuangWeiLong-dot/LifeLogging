  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "今日实际花费（元）",
      "description": "**权威数字**：来自 DeepSeek 平台账号的用量接口，和官网页面上那个数一模一样。它包含**所有**用这把 key 的东西 —— Claude Code、编辑器、本流水线，全都算在内。⚠️ 它不是「日记花了多少钱」，是「今天这个账号被扣了多少钱」。",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "lifelogging-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "lifelogging-sqlite"
          },
          "rawQuery": true,
          "rawQueryText": "SELECT ROUND(value_num,2) AS v FROM events WHERE domain='ai' AND metric='spend' AND day_local = date('now','+8 hours')",
          "queryType": "table"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
