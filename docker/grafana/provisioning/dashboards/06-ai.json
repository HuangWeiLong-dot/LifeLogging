          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "lifelogging-sqlite"
          },
          "rawQuery": true,
          "rawQueryText": "SELECT ROUND(COALESCE(SUM(value_num),0),4) AS v FROM events WHERE domain='ai' AND metric='daily_cost' AND day_local = date('now','+8 hours')",
          "queryType": "table"
