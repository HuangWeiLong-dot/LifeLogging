        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "近 30 天停留",
      "description": "visit 类事件的条数。Dawarich 自己的 /visits 恒为空，这些是 collect_phone.py 从原始点本地推导出来的。",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "lifelogging-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "lifelogging-sqlite"
          },
          "rawQuery": true,
          "rawQueryText": "SELECT COUNT(*) AS stays FROM events WHERE domain='location' AND metric='visit' AND day_local >= date('now','+8 hours','-30 days')",
          "queryType": "table"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "近 30 天出门",
      "description": "当天「离开上一个停留点 → 到达下一个停留点」的时间合计。口径是**停留点的间隔**，不是 Dawarich 判为移动的段 —— 后者在地铁里会严重少算（14 号 110 分钟的通勤，Dawarich 只认出 50.8 分钟在移动）。⚠️ 一天只有一个停留点时算不出来，那天记 0。",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "lifelogging-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "lifelogging-sqlite"
          },
          "rawQuery": true,
          "rawQueryText": "WITH v AS (SELECT day_local, json_extract(meta_json,'$.end_utc') AS end_utc, LEAD(ts_utc) OVER (PARTITION BY day_local ORDER BY ts_utc) AS next_start FROM events WHERE domain='location' AND metric='visit' AND day_local >= date('now','+8 hours','-30 days')) SELECT ROUND(SUM((julianday(next_start) - julianday(end_utc)) * 24.0), 1) AS h FROM v WHERE next_start IS NOT NULL",
          "queryType": "table"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "每日轨迹点与活动范围",
      "description": "点数突然掉下去 = 手机那边出问题了（电池优化杀了定位、没连上 Tailscale 等）。",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "lifelogging-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "lifelogging-sqlite"
          },
          "rawQuery": true,
          "timeColumns": [
            "time"
          ],
          "rawQueryText": "SELECT strftime('%Y-%m-%dT%H:%M:%S+08:00', day_local) AS time, MAX(value_num) AS '轨迹点', ROUND(MAX(json_extract(meta_json,'$.span_km')),1) AS '活动范围(km)' FROM events WHERE domain='location' AND metric='tracked_points' GROUP BY day_local ORDER BY day_local",
          "queryType": "time series"
        }
      ],
      "options": {
