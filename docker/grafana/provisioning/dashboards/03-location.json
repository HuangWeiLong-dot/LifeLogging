{
  "uid": "lifelogging-location",
  "title": "生命记录 · 位置",
  "description": "来自 Dawarich。原始轨迹点只存在服务器上，这里画的是 collect_phone.py 每天写进事件表的汇总与停留。",
  "tags": [
    "lifelogging"
  ],
  "timezone": "Asia/Shanghai",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "今日活动范围",
      "description": "当天所有轨迹点的外接矩形跨度（meta_json 的 span_km）。在家不动的话是 0。",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "lifelogging-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "lifelogging-sqlite"
          },
          "rawQuery": true,
          "rawQueryText": "SELECT ROUND(COALESCE(MAX(json_extract(meta_json,'$.span_km')),0),1) AS km FROM events WHERE domain='location' AND metric='tracked_points' AND day_local = date('now','+8 hours')",
          "queryType": "table"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "km",
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "今日轨迹点",
      "description": "手机当天上报的 GPS 点数。手机没电、没网、或被系统杀了定位，这里就会掉。",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "lifelogging-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "lifelogging-sqlite"
          },
          "rawQuery": true,
          "rawQueryText": "SELECT COALESCE(SUM(value_num),0) AS points FROM events WHERE domain='location' AND metric='tracked_points' AND day_local = date('now','+8 hours')",
          "queryType": "table"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "近 30 天停留",
      "description": "visit 类事件的条数。Dawarich 自己的 /visits 恒为空，这些是 collect_phone.py 从原始点本地推导出来的。",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "lifelogging-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "lifelogging-sqlite"
          },
          "rawQuery": true,
          "rawQueryText": "SELECT COUNT(*) AS stays FROM events WHERE domain='location' AND metric='visit' AND day_local >= date('now','+8 hours','-30 days')",
          "queryType": "table"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "近 30 天出行",
      "description": "transport 类事件合计时长。只统计真正在移动的段，原地不动不计入。",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "lifelogging-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "lifelogging-sqlite"
          },
          "rawQuery": true,
          "rawQueryText": "SELECT ROUND(COALESCE(SUM(value_num),0)/60.0,1) AS h FROM events WHERE domain='location' AND metric='transport' AND day_local >= date('now','+8 hours','-30 days')",
          "queryType": "table"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "每日轨迹点与活动范围",
      "description": "点数突然掉下去 = 手机那边出问题了（电池优化杀了定位、没连上 Tailscale 等）。",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "lifelogging-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "lifelogging-sqlite"
          },
          "rawQuery": true,
          "timeColumns": [
            "time"
          ],
          "rawQueryText": "SELECT strftime('%Y-%m-%dT%H:%M:%S+08:00', day_local) AS time, MAX(value_num) AS '轨迹点', ROUND(MAX(json_extract(meta_json,'$.span_km')),1) AS '活动范围(km)' FROM events WHERE domain='location' AND metric='tracked_points' GROUP BY day_local ORDER BY day_local",
          "queryType": "time series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "轨迹点"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "left"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "活动范围(km)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "km"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.drawStyle",
                "value": "line"
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "最近停留",
      "description": "今天两次停留就能看出来：一次 366 分钟在家（Yingpu），一次 232 分钟在城北。",
      "gridPos": {
        "h": 10,
        "w": 14,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "lifelogging-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "lifelogging-sqlite"
          },
          "rawQuery": true,
          "rawQueryText": "SELECT datetime(ts_utc,'+8 hours') AS '开始(本地)', day_local AS '日期', ROUND(value_num,1) AS '分钟', value_text AS '地点', json_extract(meta_json,'$.points') AS '点数' FROM events WHERE domain='location' AND metric='visit' ORDER BY ts_utc DESC LIMIT 200",
          "queryType": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "分钟"
            },
            "properties": [
              {
                "id": "unit",
                "value": "m"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "地点"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 300
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "交通方式",
      "description": "只统计真正在移动的段 —— 原地不动的整段会被 dawarich 标成 📍，collect_phone.py 会把它们排除掉。",
      "gridPos": {
        "h": 10,
        "w": 10,
        "x": 14,
        "y": 12
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "lifelogging-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "lifelogging-sqlite"
          },
          "rawQuery": true,
          "rawQueryText": "SELECT value_text AS '方式', ROUND(SUM(value_num),0) AS '分钟', COUNT(*) AS '段数' FROM events WHERE domain='location' AND metric='transport' GROUP BY value_text ORDER BY 2 DESC",
          "queryType": "table"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "stacking": "none",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85,
            "axisPlacement": "auto",
            "axisLabel": "",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      }
    }
  ]
}