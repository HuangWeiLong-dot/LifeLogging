    {
      "id": 8,
      "type": "table",
      "title": "交通段明细（含当时手机前台应用）",
      "description": "每一段 Dawarich 判定的「移动」，加上那个时间段手机前台开着什么应用。用途很具体：判断某个模式判得对不对。比如它说 driving，但那一栏写着 Shanghai Metro，那显然是地铁不是开车。⚠️ 手机事件是 2026-10-14 傍晚才接进来的，之前的时间段这一列会是空的。",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "lifelogging-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "lifelogging-sqlite"
          },
          "rawQuery": true,
          "rawQueryText": "SELECT datetime(t.ts_utc,'+8 hours') AS '开始(本地)', datetime(json_extract(t.meta_json,'$.end_utc'),'+8 hours') AS '结束(本地)', ROUND(t.value_num,1) AS '时长', t.value_text AS 'Dawarich 判定', (SELECT group_concat(DISTINCT p.value_text) FROM events p  WHERE p.domain='phone' AND p.metric='app_switch'  AND p.ts_utc >= t.ts_utc AND p.ts_utc <= json_extract(t.meta_json,'$.end_utc')) AS '该时段手机前台应用', t.day_local AS '日期' FROM events t WHERE t.domain='location' AND t.metric='transport' ORDER BY t.ts_utc DESC LIMIT 100",
          "queryType": "table"
        }
      ],
