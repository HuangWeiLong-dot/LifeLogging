# 每 2 分钟发布一次 24h 实时快照。
#
# 为什么是 2 分钟：站点 LifeNow 每 30 秒轮询，笔记本上的实时任务也是 2 分钟；
# 服务器这条用同样的节拍，笔记本关掉后站点的延迟不会突然从 2 分钟变成一夜。
#
# OnBootSec 让重启后也尽快补一份，不用等第一个 2 分钟窗口。

[Unit]
Description=LifeLogging - publish live NOW every 2 minutes
Requires=lifelogging-live-now.service

[Timer]
OnBootSec=2min
OnUnitActiveSec=2min
AccuracySec=15s
Persistent=true

[Install]
WantedBy=timers.target
