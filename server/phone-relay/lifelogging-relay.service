# systemd 单元 —— 手机使用事件中继
#
# 安装：
#   sudo cp lifelogging-relay.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now lifelogging-relay
#
# 密钥写在 /etc/lifelogging/relay.env 里（见 README），不要写进这个文件 ——
# 这个文件是要进 git 的。
#
# ⚠️ 改完这个文件要 `daemon-reload` 才生效，只 restart 不行。

[Unit]
Description=LifeLogging phone-usage relay (Tasker -> server -> laptop)
Documentation=https://github.com/  # 指向你自己的仓库
After=network-online.target
Wants=network-online.target
# Tailscale 起来之前绑不上 100.x 地址，所以等它
After=tailscaled.service

[Service]
Type=simple

# 运行身份：**root，而且显式写出来**。
#
# 这台机器上没有专用服务用户，也**不打算建** —— 用户一直用 root 登录，
# 对他来说多一个用户的隔离成本高于收益。（建议过一次，被否了。）
#
# 显式写 root 而不是省略：省略也等于 root，但读这份文件的人看不出来，
# 出问题时也少一个可以改的旋钮。
#
# 所以加固的重心放在**即使用 root 也生效**的那些指令上 —— 下面那组
# ProtectSystem / ProtectHome / CapabilityBoundingSet= / ReadWritePaths
# 就是干这个的：绑成 root 也进不了 /root，也只能写 /var/lib/lifelogging。
User=root
Group=root

# ⚠️ 只绑 Tailscale 地址。写 0.0.0.0 会把公网和局域网一起开出去 ——
#    这是个人生命记录，不该有对外入口。
Environment=RELAY_HOST=127.0.0.1
Environment=RELAY_PORT=8788
Environment=RELAY_DATA_DIR=/var/lib/lifelogging
Environment=RELAY_TZ=Asia/Shanghai
EnvironmentFile=/etc/lifelogging/relay.env

# 代码是 git clone 到 /opt/lifelogging/repo 的（见 server/README.md），
# 所以这里指向 checkout 里的路径 —— 升级就是 git pull，不用再手工 scp。
ExecStart=/usr/bin/python3 /opt/lifelogging/repo/server/phone-relay/phone_relay.py

Restart=always
RestartSec=3

# 基础加固：这个进程只需要「读自己的脚本 + 写数据目录 + 监听 8788」三件事，
# 别的能力全部不要。**以 root 跑的话这几条就是主要防线。**
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lifelogging
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true

# 丢掉所有 Linux capability。
# 8788 是高位端口（不需要 CAP_NET_BIND_SERVICE），
# 它也不碰内核、不挂载、不改时钟 —— 一个都不需要。
# ⚠️ 这条在**以 root 跑**时尤其值钱：root + 空 capability 集
#    比裸 root 小得多，而对这个服务毫无损失。
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
