# LifeLogging —— 服务器侧：根据当天的位置/手机数据生成「实时提问」
#
# 和 close-day 一样是 oneshot + timer，但有两点不同：
#   · close-day 的**门**是「笔记本推了终版输入」（所以它晚上才干活）；
#     这个脚本的门是**时钟**（白天每 30 分钟扫一次今天的数据）。
#     两者的节奏和失败方式都不一样，所以是两个独立的 timer。
#   · 它要读 Dawarich（位置）和中继，但不写日记、不调 AI。
#
# 部署步骤见同目录 README.md。

[Unit]
Description=LifeLogging - generate live questions from today's data
After=network-online.target tailscaled.service lifelogging-relay.service
Wants=network-online.target
# 它要从中继读今天的手机事件、把生成的问题推回中继
Requires=lifelogging-relay.service

[Service]
Type=oneshot
# 运行身份：root，显式写出（理由见 phone-relay 那个 unit —— 这台机器上不建
# 专用服务用户）。加固靠下面那组 ProtectSystem / CapabilityBoundingSet。
User=root
Group=root
WorkingDirectory=/opt/lifelogging/repo

# 中继那把 key 从它自己的文件里读（config.yaml 里那份才是主，这里只是兜底）。
EnvironmentFile=-/etc/lifelogging/relay.env

# ⚠️ 城市数据表放哪 —— 和 feishu-bot 同一个目录。默认值是仓库里的 data/，
#    而下面 ProtectSystem=strict 让它只读，那会导致反查地名失败并**静默**
#    退回坐标（问出来的是「你在 (39.9042,116.4074) 待了两小时」）。
Environment=LIFELOGGING_DATA_DIR=/var/lib/lifelogging/geo

ExecStart=/opt/lifelogging/venv/bin/python /opt/lifelogging/repo/scripts/live_questions.py

# 拉一次位置 + 一次中继，正常几秒。给足余量但别无限挂。
TimeoutStartSec=180

# 和 phone_relay / close-day 同一套加固
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
AmbientCapabilities=
# ⚠️ 它要写 live-asked-<day>.json（当天已问过哪些，防重复）+ 可能要下城市数据表。
#    少了这行的表现是「每次跑都当成没问过」，于是同一件事被反复问，且不报错。
ReadWritePaths=/var/lib/lifelogging

# ⚠️ **不要**加 RestrictAddressFamilies= / IPAddressAllow= / PrivateNetwork=。
#    它必须能出站访问 Dawarich 和本机中继。
